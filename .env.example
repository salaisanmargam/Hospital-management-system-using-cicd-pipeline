# ─────────────────────────────────────────
#  MedCore HMS – Environment Variables
#  Copy this file to .env and fill in your values.
#  NEVER commit a real .env file to source control.
# ─────────────────────────────────────────

# ── PostgreSQL / Neon DB ──────────────────────────────────────────────────────
# Obtain from https://console.neon.tech → your project → Connection Details
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_POOL_SIZE=5

# ── FastAPI / Auth ─────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# ── CORS ───────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
APP_CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ── App ────────────────────────────────────────────────────────────────────────
APP_NAME=MedCore API

# ── Vite / Frontend ────────────────────────────────────────────────────────────
# URL of the backend API (no trailing slash).
# LOCAL DEVELOPMENT: copy this file to .env.local and keep the value below.
# PRODUCTION (Vercel): .env.production (committed) sets VITE_API_URL=/api
#   automatically, so Vite build picks up the relative path – no changes needed.
VITE_API_URL=http://localhost:8000

# Set to "true" to bypass live auth and use mock users (dev only)
VITE_USE_MOCK_AUTH=false

# ── AI / Gemini (optional) ─────────────────────────────────────────────────────
GEMINI_API_KEY=
