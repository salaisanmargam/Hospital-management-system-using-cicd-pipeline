{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 30,
        "includeFiles": ["backend/**"]
      }
    },
    {
      "src": "frontend/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "env": {
    "APP_NAME": "MedCore API",
    "APP_CORS_ORIGINS": "https://medcore-xi.vercel.app",
    "JWT_ALGORITHM": "HS256",
    "JWT_EXPIRE_MINUTES": "480",
    "DB_POOL_SIZE": "5"
  }
}
