# ── PostgreSQL / Neon DB ─────────────────────────────────────────────────────
# Loaded from root .env — keep DATABASE_URL there (single source of truth).
# If you want to override here, uncomment and fill in:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DB_POOL_SIZE=5

# ── FastAPI / App ─────────────────────────────────────────────────────────────
APP_NAME=MedCore API
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change_this_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
